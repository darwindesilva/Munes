// ============================================================
// Munes Music v12
// - Fixed: one chord change per takeoff, no array overrun
// - Chord fade-off timer: chord fades after FADE_AFTER_MS
//   on the ground so a single chord doesn't drone forever
// - Bass grounded / treble airborne
// - Air-time gate for chord changes
// ============================================================

// ---- Unity inputs ----
global float in_speed;
global int   in_grounded;
global int   in_takeoff;
global int   in_landed;
global float in_height;
global float in_timeToLand;
global int   in_quadrant;

// ---- Tunables ----
150.0 => float HEIGHT_TOP;
0.06  => float BASE_VOICE_GAIN;
0.20  => float BASS_VOICE_GAIN;
0.07  => float TREBLE_VOICE_GAIN;
0.02  => float MIN_SLIDE_RATE;
0.60  => float MAX_SLIDE_RATE;
400   => int   MIN_SLIDE_MS;
10000 => int   MAX_SLIDE_MS;
3     => int   OCTAVES;
300   => int   MIN_AIRTIME_MS;

// Fade-off: after a chord has been playing this long WHILE GROUNDED
// (and grounded without further chord changes), silence all voices
// over FADE_DURATION_MS. Cleared the moment a takeoff arms a change.
6000  => int   FADE_AFTER_MS;      // start fading after 6 s grounded
2000  => int   FADE_DURATION_MS;   // fade length

// ============================================================
// --------- PASTE GENERATED BLOCK BELOW THIS LINE -----------
// ============================================================

// ============================================================
// AUTO-GENERATED by generate_chuck_graph.py
// ============================================================

4 => int NOTES_PER_CHORD;
6 => int NODE_COUNT;
10 => int CHORD_COUNT;

// Node index reference:
//    0  CFG       [C4 E4 G4 -> F3 A3 C4 -> G3 B3 D4]  → Am, Fmaj, CFG
//    1  Am        [A3 C4 E4 -> F3 A3 C4]  → CFG, Em
//    2  Fmaj      [F3 A3 C4 E4]  → CFG, G
//    3  G         [G3 B3 D4 -> C4 E4 G4]  → C, Am
//    4  Em        [E3 G3 B3]  → Am, CFG
//    5  C         [C4 E4 G4]  → Fmaj, G

// Each chord = NOTES_PER_CHORD MIDI slots. -1 = silent.
[
   60,  64,  67,  -1,  //  0
   53,  57,  60,  -1,  //  1
   55,  59,  62,  -1,  //  2
   57,  60,  64,  -1,  //  3
   53,  57,  60,  -1,  //  4
   53,  57,  60,  64,  //  5
   55,  59,  62,  -1,  //  6
   60,  64,  67,  -1,  //  7
   52,  55,  59,  -1,  //  8
   60,  64,  67,  -1,  //  9
] @=> int CHORDS[];

[ 36,  36,  36,  33,  33,  29,  31,  31,  40,  36] @=> int BASS_NOTES[];

[ 79,  79,  79,  76,  76,  72,  74,  74,  71,  79] @=> int TREBLE_NOTES[];

// Node → chord range mapping
[0, 3, 5, 6, 8, 9] @=> int NODE_CHORD_OFFSETS[];
[3, 2, 1, 2, 1, 1] @=> int NODE_CHORD_COUNTS[];

// Node graph
[0, 3, 5, 7, 9, 11] @=> int SUCC_OFFSETS[];
[3, 2, 2, 2, 2, 2] @=> int SUCC_COUNTS[];
[1, 2, 0, 0, 4, 0, 3, 5, 1, 1, 0, 2, 3] @=> int SUCC_TARGETS[];

32 => int MAX_VOICES;
TriOsc voices[MAX_VOICES];
LPF    filters[MAX_VOICES];

int VOICE_COUNT;
NOTES_PER_CHORD * OCTAVES => VOICE_COUNT;
int TOTAL_VOICES;
VOICE_COUNT + 2 => TOTAL_VOICES;
int BASS_IDX;
VOICE_COUNT => BASS_IDX;
int TREBLE_IDX;
VOICE_COUNT + 1 => TREBLE_IDX;

for (0 => int i; i < TOTAL_VOICES; i++) {
    new TriOsc @=> voices[i];
    new LPF    @=> filters[i];
    voices[i] => filters[i] => dac;
    3000.0 => filters[i].freq;
    Std.mtof(60) => voices[i].freq;
    0.0 => voices[i].gain;
}
<<< "voice pool:", TOTAL_VOICES, "| chord voices:", VOICE_COUNT, "| chords:", CHORD_COUNT >>>;

// ---- State ----
0 => int currentNodeIdx;
0 => int currentChordInNode;
0 => int currentChordIdx;

float currentFreqs[32];
float targetFreqs[32];
float currentGains[32];
float targetGains[32];
float fadeMultiplier[32];    // per-voice 0..1 fade applied on top of gains

int   sliding;
int   slideElapsedMs;
int   slideTotalMs;
float slideFreqLerp;

int   msSinceTakeoff;
int   pendingChange;

int   msSinceLastChange;     // counts up while grounded, reset on any change
int   fadingOut;             // 1 while the fade-out is running

// ============================================================
// Helpers
// ============================================================

fun float absFloat(float x) {
    if (x < 0.0) return -x;
    return x;
}

fun int chordGlobalIdx(int nodeIdx, int chordInNode) {
    return NODE_CHORD_OFFSETS[nodeIdx] + chordInNode;
}

fun void computeTargets(int chordIdx) {
    // Safety clamp in case of bad state
    if (chordIdx < 0) { 0 => chordIdx; }
    if (chordIdx >= CHORD_COUNT) { CHORD_COUNT - 1 => chordIdx; }

    for (0 => int slot; slot < NOTES_PER_CHORD; slot++) {
        CHORDS[chordIdx * NOTES_PER_CHORD + slot] => int midi;
        for (0 => int o; o < OCTAVES; o++) {
            slot * OCTAVES + o => int idx;
            if (midi < 0) { -1.0 => targetFreqs[idx]; }
            else { Std.mtof(midi + 12 * o) => targetFreqs[idx]; }
        }
    }
    BASS_NOTES[chordIdx] => int bMidi;
    if (bMidi < 0) { -1.0 => targetFreqs[BASS_IDX]; }
    else { Std.mtof(bMidi) => targetFreqs[BASS_IDX]; }
    TREBLE_NOTES[chordIdx] => int tMidi;
    if (tMidi < 0) { -1.0 => targetFreqs[TREBLE_IDX]; }
    else { Std.mtof(tMidi) => targetFreqs[TREBLE_IDX]; }
}

fun float octaveWeight(int o, float h) {
    (o * 1.0) / ((OCTAVES - 1) * 1.0) => float center;
    absFloat(h - center) => float d;
    Math.exp(-d * d * 1.5) => float w;
    return w;
}

fun void updateGains(float h) {
    for (0 => int i; i < VOICE_COUNT; i++) {
        if (targetFreqs[i] < 0) { 0.0 => targetGains[i]; }
        else {
            i % OCTAVES => int o;
            octaveWeight(o, h) * BASE_VOICE_GAIN => targetGains[i];
        }
    }
    if (targetFreqs[BASS_IDX] < 0) { 0.0 => targetGains[BASS_IDX]; }
    else if (in_grounded == 1) { BASS_VOICE_GAIN => targetGains[BASS_IDX]; }
    else { 0.0 => targetGains[BASS_IDX]; }

    if (targetFreqs[TREBLE_IDX] < 0) { 0.0 => targetGains[TREBLE_IDX]; }
    else if (in_grounded == 0) { TREBLE_VOICE_GAIN => targetGains[TREBLE_IDX]; }
    else { 0.0 => targetGains[TREBLE_IDX]; }
}

fun int pickSuccessorNode(int fromNode) {
    if (fromNode < 0 || fromNode >= NODE_COUNT) return 0;
    SUCC_COUNTS[fromNode] => int n;
    if (n <= 0) return fromNode;
    Math.random2f(0.0, 1.0) => float r;
    (r * n) $ int => int idx;
    if (idx >= n) { n - 1 => idx; }
    return SUCC_TARGETS[SUCC_OFFSETS[fromNode] + idx];
}

fun void beginSlideTo(int chordIdx, int ttlMs) {
    computeTargets(chordIdx);

    ttlMs => slideTotalMs;
    if (slideTotalMs < MIN_SLIDE_MS) { MIN_SLIDE_MS => slideTotalMs; }
    if (slideTotalMs > MAX_SLIDE_MS) { MAX_SLIDE_MS => slideTotalMs; }

    slideTotalMs / 50 => int ticks;
    if (ticks < 1) { 1 => ticks; }
    1.0 - Math.pow(0.005, 1.0 / ticks) => slideFreqLerp;
    if (slideFreqLerp < MIN_SLIDE_RATE) { MIN_SLIDE_RATE => slideFreqLerp; }
    if (slideFreqLerp > MAX_SLIDE_RATE) { MAX_SLIDE_RATE => slideFreqLerp; }

    0 => slideElapsedMs;
    1 => sliding;
    chordIdx => currentChordIdx;
    0 => msSinceLastChange;
    0 => fadingOut;
    for (0 => int i; i < TOTAL_VOICES; i++) { 1.0 => fadeMultiplier[i]; }

    <<< "CHANGE → chord", currentChordIdx, "over", slideTotalMs, "ms" >>>;
}

// ============================================================
// Initialization
// ============================================================
0 => currentNodeIdx;
0 => currentChordInNode;
chordGlobalIdx(currentNodeIdx, currentChordInNode) => currentChordIdx;
computeTargets(currentChordIdx);

in_height => float hRaw;
if (hRaw < 0.0) { 0.0 => hRaw; }
hRaw / HEIGHT_TOP => float h0;
if (h0 > 1.0) { 1.0 => h0; }
updateGains(h0);

for (0 => int i; i < TOTAL_VOICES; i++) {
    if (targetFreqs[i] > 0) {
        targetFreqs[i] => currentFreqs[i];
        currentFreqs[i] => voices[i].freq;
    } else { 0.0 => currentFreqs[i]; }
    targetGains[i] => currentGains[i];
    currentGains[i] => voices[i].gain;
    1.0 => fadeMultiplier[i];
}

0 => sliding;
0 => msSinceTakeoff;
0 => pendingChange;
0 => msSinceLastChange;
0 => fadingOut;

<<< "=== Munes Music v12 starting ===" >>>;

// ============================================================
// Main loop
// ============================================================
while (true) {

    // ---- Track air time ----
    if (in_grounded == 0) { msSinceTakeoff + 50 => msSinceTakeoff; }
    else { msSinceLastChange + 50 => msSinceLastChange; }

    // ---- Takeoff: arm a pending change ----
    if (in_takeoff == 1) {
        0 => msSinceTakeoff;
        1 => pendingChange;
        // Cancel any active fade immediately
        0 => fadingOut;
        for (0 => int i; i < TOTAL_VOICES; i++) { 1.0 => fadeMultiplier[i]; }
        <<< "TAKEOFF armed (ttl≈", in_timeToLand, "s)" >>>;
    }

    // ---- Airborne: commit once the min air time has elapsed, ONE TIME ONLY ----
    if (pendingChange == 1
        && sliding == 0
        && in_grounded == 0
        && msSinceTakeoff >= MIN_AIRTIME_MS)
    {
        // Advance within node
        currentChordInNode + 1 => int nextChordInNode;
        if (nextChordInNode >= NODE_CHORD_COUNTS[currentNodeIdx]) {
            pickSuccessorNode(currentNodeIdx) => currentNodeIdx;
            0 => nextChordInNode;
        }
        nextChordInNode => currentChordInNode;

        chordGlobalIdx(currentNodeIdx, currentChordInNode) => int nextChordIdx;

        in_timeToLand => float ttl;
        if (ttl < 0.0) { 4.0 => ttl; }
        if (ttl > 30.0) { 30.0 => ttl; }
        (ttl * 1000.0) $ int => int ttlMs;

        beginSlideTo(nextChordIdx, ttlMs);
        0 => pendingChange;
    }

    // ---- Landing: cancel pending if too short ----
    if (in_landed == 1) {
        if (pendingChange == 1 && msSinceTakeoff < MIN_AIRTIME_MS) {
            <<< "  short flight (", msSinceTakeoff, "ms) — change cancelled" >>>;
        }
        0 => pendingChange;
        0 => msSinceTakeoff;
    }

    // ---- Fade-off logic ----
    // Only fade while grounded AND no slide is running AND no pending change
    if (in_grounded == 1 && sliding == 0 && pendingChange == 0) {
        if (msSinceLastChange >= FADE_AFTER_MS) {
            1 => fadingOut;
        }
    } else {
        0 => fadingOut;
    }

    // Compute per-tick fade multiplier
    if (fadingOut == 1) {
        // Linear ramp from 1 to 0 over FADE_DURATION_MS
        msSinceLastChange - FADE_AFTER_MS => int fadedMs;
        if (fadedMs < 0) { 0 => fadedMs; }
        if (fadedMs > FADE_DURATION_MS) { FADE_DURATION_MS => fadedMs; }
        1.0 - (fadedMs * 1.0) / FADE_DURATION_MS => float fm;
        for (0 => int i; i < TOTAL_VOICES; i++) { fm => fadeMultiplier[i]; }
    }

    // ---- Height → gains ----
    in_height => float hR;
    if (hR < 0.0) { 0.0 => hR; }
    hR / HEIGHT_TOP => float h;
    if (h > 1.0) { 1.0 => h; }
    updateGains(h);

    // ---- Frequency slide ----
    0.15 => float baseLerp;
    for (0 => int i; i < TOTAL_VOICES; i++) {
        if (targetFreqs[i] > 0) {
            baseLerp => float thisLerp;
            if (sliding == 1) { slideFreqLerp => thisLerp; }
            currentFreqs[i] + (targetFreqs[i] - currentFreqs[i]) * thisLerp => currentFreqs[i];
            currentFreqs[i] => voices[i].freq;
        }
    }

    if (sliding == 1) {
        slideElapsedMs + 50 => slideElapsedMs;
        if (slideElapsedMs >= slideTotalMs) { 0 => sliding; }
    }

    // ---- Gain smoothing × fade multiplier ----
    0.08 => float gainLerp;
    for (0 => int i; i < TOTAL_VOICES; i++) {
        currentGains[i] + (targetGains[i] - currentGains[i]) * gainLerp => currentGains[i];
        currentGains[i] * fadeMultiplier[i] => voices[i].gain;
    }

    50::ms => now;
}